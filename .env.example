# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Used by the CLI entrypoints (scripts/ingest.py, scripts/run_eval.py,
# scripts/sweep.py). The Streamlit app reads .streamlit/secrets.toml instead.
#
# GROQ_API_KEY_FILE is an alternative: point it at a file holding the key and
# it never enters your shell history or the environment of every process you
# launch. See secrets/groq_api_key.txt.example.

# Required. https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Only needed if observability.langsmith.enabled is true
# in configs/default.json.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true

# Optional. Silences the HuggingFace tokenizers fork warning during ingest.
TOKENIZERS_PARALLELISM=false
