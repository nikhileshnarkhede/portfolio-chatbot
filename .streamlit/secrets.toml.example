# Copy to .streamlit/secrets.toml and fill in.
# secrets.toml is gitignored. On Streamlit Cloud, paste these into
# App settings -> Secrets instead of committing the file.

GROQ_API_KEY = "gsk_your_key_here"

# Optional: run the deployed app under a named experiment config.
# Leave unset to use configs/default.json.
# EXPERIMENT = "exp001_baseline"
