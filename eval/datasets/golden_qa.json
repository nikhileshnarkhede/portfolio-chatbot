{
  "_meta": {
    "description": "Ground truth for the portfolio chatbot. Every field is optional; a case only asserts what it cares about, so adding a case is cheap and a case never fails for a reason it did not intend to test.",
    "fields": {
      "id": "stable identifier - referenced in reports, so do not renumber",
      "question": "exactly what a recruiter would type",
      "expected_route": "routing rule name that should fire, or null to assert NO rule matches (the question should reach MMR)",
      "expected_chunk_types": "chunk_types the retrieved context should consist of; drives type_precision",
      "expected_identities": "chunks that must be retrieved, named by identity substring, NOT chunk_id hash - readable, and survives a re-chunk",
      "must_contain": "case-insensitive substrings the answer must include; drives fact_coverage",
      "must_not_contain": "substrings that would indicate a wrong or fabricated answer",
      "expect_refusal": "true if the resume genuinely cannot answer this; false to assert the bot must NOT refuse a question it can answer",
      "primary_identities": "chunks that are THE answer, not merely relevant context. Grade 2 for nDCG; everything in expected_identities is grade 1. Optional - a case without it scores nDCG on binary relevance."
    },
    "note": "Identities were taken from the parsed resume, not invented. Keep them accurate: a golden set that drifts from the source is worse than none, because it produces confident wrong numbers.",
    "version": 2
  },
